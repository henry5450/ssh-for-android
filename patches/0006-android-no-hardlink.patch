diff --git a/mux.c b/mux.c
index e774938..6378af9 100644
--- a/mux.c
+++ b/mux.c
@@ -1373,6 +1373,18 @@ muxserver_listen(struct ssh *ssh)
 	}
 
 	/* Now atomically "move" the mux socket into position */
+#ifdef __ANDROID__
+	/* Android denies hard links under /data/local/tmp. */
+	if (access(orig_control_path, F_OK) == 0) {
+		error("ControlSocket %s already exists, disabling multiplexing",
+		    orig_control_path);
+		unlink(options.control_path);
+		goto disable_mux_master;
+	} else if (rename(options.control_path, orig_control_path) == -1) {
+		fatal_f("rename mux listener %s => %s: %s",
+		    options.control_path, orig_control_path, strerror(errno));
+	}
+#else
 	if (link(options.control_path, orig_control_path) != 0) {
 		if (errno != EEXIST) {
 			fatal_f("link mux listener %s => %s: %s",
@@ -1385,6 +1397,7 @@ muxserver_listen(struct ssh *ssh)
 		goto disable_mux_master;
 	}
 	unlink(options.control_path);
+#endif
 	free(options.control_path);
 	options.control_path = orig_control_path;
 
