+#ifdef __ANDROID__
+/*
+ * This Android build keeps all client state under a fixed directory.
+ * bionic reports "/" as the pw_dir for root/shell, and adb shell's $HOME
+ * is not reliable, so use SSH_ANDROID_HOME if set and this fixed path
+ * otherwise.
+ */
+char *
+android_home(void)
+{
+	const char *home = getenv("SSH_ANDROID_HOME");
+
+	if (home != NULL && *home != '\0')
+		return xstrdup(home);
+	return xstrdup("/data/local/tmp/home");
+}
+
+void
+android_override_pw_dir(struct passwd *pw)
+{
+	if (pw == NULL)
+		return;
+	free(pw->pw_dir);
+	pw->pw_dir = android_home();
+}
+#endif
